# --- App ---
# Local dev: leave as sqlite. Production on Vercel: use Supabase's *pooled*
# connection string, not the direct one — Project Settings -> Database ->
# Connection string -> "Transaction" mode (port 6543). Serverless functions
# open a lot of short-lived connections; the direct connection (port 5432)
# has a low connection ceiling that concurrent invocations will hit fast.
DATABASE_URL=sqlite:///./sms_reseller.db

# --- Supabase (auth) ---
# Project Settings -> API. The frontend uses the URL + anon key directly;
# the backend only needs the JWT secret, to verify tokens Supabase issues.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-dashboard

# --- Upstream provider (wholesale side) ---
# Which adapter to use: "fivesim" | "smsactivate" | "smsman" | "mock"
PROVIDER=mock
PROVIDER_API_KEY=your-provider-api-key-here
PROVIDER_BASE_URL=https://api.example-provider.com

# --- FX ---
# USD -> NGN rate. In production, replace with a live rate fetch (cached, refreshed hourly).
USD_NGN_RATE=1600

# --- Pricing / markup ---
# Applied in this order: cost_usd -> cost_ngn -> + PERCENT markup -> + FLAT fee -> round
MARKUP_PERCENT=45
MARKUP_FLAT_NGN=50
MIN_PRICE_NGN=150

# --- Order behaviour ---
ORDER_TIMEOUT_SECONDS=600
POLL_INTERVAL_SECONDS=5

# --- Korapay (payment gateway) ---
# From your Korapay dashboard: Settings -> API Keys.
# Use test keys (pk_test_/sk_test_) until you're ready to go live.
KORAPAY_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_REDIRECT_URL=https://yourapp.example.com/wallet/topup/complete

# --- Environment / admin ---
# Keep DEBUG unset or false in production — it gates dev-only routes like
# the free-money test topup endpoint.
DEBUG=false
# Comma-separated emails always treated as admin (bootstraps your first
# admin account without needing the panel to already exist).
ADMIN_EMAILS=you@example.com

# --- Provider fallback ---
# Comma-separated fallback adapters, tried in order if the primary PROVIDER
# is out of stock or errors. e.g. PROVIDER=fivesim, PROVIDER_FALLBACK=smsman
PROVIDER_FALLBACK=smsman
SMSMAN_API_KEY=your-smsman-api-key-here

# --- Email (Brevo) ---
# Get a key from Brevo -> Settings -> SMTP & API -> API Keys. Also verify a
# sender identity there before this will actually send. Leave blank to
# disable transactional emails (order receipts, top-up confirmations) —
# the app runs fine without it, it just skips sending.
#
# For Supabase's own auth emails (signup confirmation, password reset),
# configure Brevo as custom SMTP directly in the Supabase dashboard instead
# of here — Project Settings -> Auth -> SMTP Settings.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=SMSOne
