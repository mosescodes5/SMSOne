+// ---------- Settings view ----------
+
+function SettingsView() {
+  const [email, setEmail] = useState(null);
+  const [newPassword, setNewPassword] = useState("");
+  const [confirmPassword, setConfirmPassword] = useState("");
+  const [saving, setSaving] = useState(false);
