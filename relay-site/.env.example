# URL of your FastAPI backend.
#
# Local dev (two separate servers, `uvicorn` + `npm run dev`):
NEXT_PUBLIC_RELAY_API_BASE=http://127.0.0.1:8811
#
# Single Vercel project via Services (one domain, frontend + backend
# together): use the relative path instead — this also means no CORS is
# needed at all, since it's no longer a cross-origin request.
# NEXT_PUBLIC_RELAY_API_BASE=/backend

# Supabase (Project Settings -> API). The anon key is safe to expose client-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
