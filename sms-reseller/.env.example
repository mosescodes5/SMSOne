# --- App ---
# Local dev: leave as sqlite. Production on Vercel: use Supabase's *pooled*
# connection string, not the direct one — Project Settings -> Database ->
# Connection string -> "Transaction" mode (port 6543). Serverless functions
# open a lot of short-lived connections; the direct connection (port 5432)
# has a low connection ceiling that concurrent invocations will hit fast.
DATABASE_URL=sqlite:///./sms_reseller.db

# --- Supabase (auth) ---
# Project Settings -> API. The frontend uses the URL + anon key directly;
# the backend only needs the JWT secret, to verify tokens Supabase issues.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-dashboard

# --- Upstream provider (wholesale side) ---
# Which adapter to use: "fivesim" | "smsactivate" | "smsman" | "mock"
PROVIDER=mock
PROVIDER_API_KEY=your-provider-api-key-here
PROVIDER_BASE_URL=https://api.example-provider.com

# --- FX ---
# USD -> NGN rate. In production, replace with a live rate fetch (cached, refreshed hourly).
USD_NGN_RATE=1600

# --- Pricing / markup ---
# Applied in this order: cost_usd -> cost_ngn -> + PERCENT markup -> + FLAT fee -> round
MARKUP_PERCENT=45
MARKUP_FLAT_NGN=50
MIN_PRICE_NGN=150

# --- Order behaviour ---
ORDER_TIMEOUT_SECONDS=600
POLL_INTERVAL_SECONDS=5

# --- Korapay (payment gateway) ---
# From your Korapay dashboard: Settings -> API Keys.
# Use test keys (pk_test_/sk_test_) until you're ready to go live.
KORAPAY_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
KORAPAY_REDIRECT_URL=https://yourapp.example.com/wallet/topup/complete
