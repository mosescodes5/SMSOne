{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "relay-site/"
    },
    "backend": {
      "root": "sms-reseller/",
      "entrypoint": "app.main:app",
      "routePrefix": "/backend"
    }
  },
  "rewrites": [
    { "source": "/backend/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
